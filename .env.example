# Content source: this (PUBLIC) repo, read by cici's GitHub provider at runtime.
# A public repo needs no token to read.
CICI_REPO=metrue/blog

# NextAuth — GitHub OAuth for /editor sign-in.
# Only the repo OWNER (derived from CICI_REPO's owner, i.e. "metrue") can edit;
# everyone else just reads. Create an OAuth App at
# https://github.com/settings/developers with callback
#   https://blog.minghe.me/api/auth/callback/github
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://blog.minghe.me
GITHUB_ID=
GITHUB_SECRET=
# GITHUB_USERNAME=metrue   # optional; owner is otherwise taken from CICI_REPO

# DO NOT set CICI_TOKEN on this hosted deploy. A shared server-side token would
# authorize *every* visitor to write via /editor. cici >= 0.6.0 ignores it in
# hosted (OAuth) mode; CICI_TOKEN is only for the localhost CLI
# (`npx cici --repo metrue/blog --token <t>`) on your own machine.
